@base <file://> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<example-file1.vcf>
  a vcfc:VCFFile ;
  vcfc:fileFormat "VCFv4.2" ;
  vcfc:fileDate "2020-06-15"^^xsd:date ;
  vcfc:sourceSoftware "CLC Genomics Grid Worker 20.9.9 Beta 1 build 209900" ;
  vcfc:referenceGenome "/CLC_References/homo_sapiens/sequence/hg38_no_alt_analysis_set/Homo_sapiens_sequence_hg38_no_alt_analysis_set" ;
  vcfc:contigCount 1 ;
  vcfc:hasHeader <example-file1.vcf#header> ;
  vcfc:hasRecord <example-file1.vcf#record/var1> .

<example-file1.vcf#header>
  a vcfc:VCFHeader ;
  vcfc:hasHeaderLine
    <example-file1.vcf#header/line/1>,
    <example-file1.vcf#header/line/2>,
    <example-file1.vcf#header/line/3>,
    <example-file1.vcf#header/line/4>,
    <example-file1.vcf#header/line/5>,
    <example-file1.vcf#header/line/6>,
    <example-file1.vcf#header/line/7>,
    <example-file1.vcf#header/line/8>,
    <example-file1.vcf#header/line/9>,
    <example-file1.vcf#header/line/10> .

<example-file1.vcf#header/line/1>
  a vcfc:FileFormatHeaderLine ;
  vcfc:headerKey "fileformat" ;
  vcfc:headerValue "VCFv4.2" .

<example-file1.vcf#header/line/2>
  a vcfc:FileDateHeaderLine ;
  vcfc:headerKey "fileDate" ;
  vcfc:headerValue "20200615" .

<example-file1.vcf#header/line/3>
  a vcfc:SourceHeaderLine ;
  vcfc:headerKey "source" ;
  vcfc:headerValue "CLC Genomics Grid Worker 20.9.9 Beta 1 build 209900" .

<example-file1.vcf#header/line/4>
  a vcfc:ReferenceHeaderLine ;
  vcfc:headerKey "reference" ;
  vcfc:headerValue "/CLC_References/homo_sapiens/sequence/hg38_no_alt_analysis_set/Homo_sapiens_sequence_hg38_no_alt_analysis_set" .

<example-file1.vcf#header/line/5>
  a vcfc:ContigHeaderLine ;
  vcfc:headerKey "contig" ;
  vcfc:headerValue "<ID=chr1,length=248956422>" ;
  vcfc:contigId "chr1" ;
  vcfc:contigLength 248956422 .

<example-file1.vcf#header/line/6>
  a vcfc:InfoFieldDefinition ;
  vcfc:headerKey "INFO" ;
  vcfc:headerValue "<ID=DP,Number=1,Type=Integer,Description=\"Total Depth\">" ;
  vcfc:fieldId "DP" ;
  vcfc:fieldNumber "1" ;
  vcfc:fieldType vcfc:IntegerType ;
  vcfc:fieldDescription "Total Depth" .

<example-file1.vcf#header/line/7>
  a vcfc:InfoFieldDefinition ;
  vcfc:headerKey "INFO" ;
  vcfc:headerValue "<ID=AF,Number=A,Type=Float,Description=\"Allele Frequency\">" ;
  vcfc:fieldId "AF" ;
  vcfc:fieldNumber "A" ;
  vcfc:fieldType vcfc:FloatType ;
  vcfc:fieldDescription "Allele Frequency" .

<example-file1.vcf#header/line/8>
  a vcfc:FormatFieldDefinition ;
  vcfc:headerKey "FORMAT" ;
  vcfc:headerValue "<ID=GT,Number=1,Type=String,Description=\"Genotype\">" ;
  vcfc:fieldId "GT" ;
  vcfc:fieldNumber "1" ;
  vcfc:fieldType vcfc:StringType ;
  vcfc:fieldDescription "Genotype" .

<example-file1.vcf#header/line/9>
  a vcfc:FormatFieldDefinition ;
  vcfc:headerKey "FORMAT" ;
  vcfc:headerValue "<ID=DP,Number=1,Type=Integer,Description=\"Total number of filtered reads used to call variants at this position in this sample.\">" ;
  vcfc:fieldId "DP" ;
  vcfc:fieldNumber "1" ;
  vcfc:fieldType vcfc:IntegerType ;
  vcfc:fieldDescription "Total number of filtered reads used to call variants at this position in this sample." .

<example-file1.vcf#header/line/10>
  a vcfc:FormatFieldDefinition ;
  vcfc:headerKey "FORMAT" ;
  vcfc:headerValue "<ID=AD,Number=R,Type=Integer,Description=\"Allele depth, number of filtered reads supporting the alleles, ordered as listed in REF and ALT.\">" ;
  vcfc:fieldId "AD" ;
  vcfc:fieldNumber "R" ;
  vcfc:fieldType vcfc:IntegerType ;
  vcfc:fieldDescription "Allele depth, number of filtered reads supporting the alleles, ordered as listed in REF and ALT." .
