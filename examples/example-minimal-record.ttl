@base <file://> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .

<example-file1.vcf>
  a vcfc:VCFFile ;
  vcfc:fileFormat "VCFv4.2" ;
  vcfc:hasRecord <example-file1.vcf#record/var1> .

<example-file1.vcf#record/var1>
  a vcfc:VCFRecord ;
  vcfc:chrom "chr1" ;
  vcfc:chromosome <example-file1.vcf#header/line/5> ;
  vcfc:pos 123456 ;
  vcfc:recordId "rs123" ;
  vcfc:ref "A" ;
  vcfc:alt "T" ;
  vcfc:hasCall <example-file1.vcf#call/var1> .

<example-file1.vcf#call/var1>
  a vcfc:VariantCall ;
  vcfc:qual 52.3 ;
  vcfc:filter "PASS" ;
  vcfc:infoRaw "DP=42;AF=0.2" ;
  vcfc:formatRaw "GT:DP:AD" ;
  vcfc:hasInfoValue
    <example-file1.vcf#call/var1/info/AF>,
    <example-file1.vcf#call/var1/info/DP> ;
  vcfc:hasSampleCall
    <example-file1.vcf#sample/var1/SAMPLE1>,
    <example-file1.vcf#sample/var1/SAMPLE2> .

<example-file1.vcf#call/var1/info/DP>
  a vcfc:InfoFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/6> ;
  vcfc:fieldValueInteger 42 .

<example-file1.vcf#call/var1/info/AF>
  a vcfc:InfoFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/7> ;
  vcfc:fieldValueDecimal 0.2 .

<example-file1.vcf#sample/var1/SAMPLE1>
  a vcfc:SampleCall ;
  vcfc:sampleId "SAMPLE1" ;
  vcfc:hasFormatValue
    <example-file1.vcf#sample/var1/SAMPLE1/fmt/AD>,
    <example-file1.vcf#sample/var1/SAMPLE1/fmt/DP>,
    <example-file1.vcf#sample/var1/SAMPLE1/fmt/GT> .

<example-file1.vcf#sample/var1/SAMPLE2>
  a vcfc:SampleCall ;
  vcfc:sampleId "SAMPLE2" ;
  vcfc:hasFormatValue
    <example-file1.vcf#sample/var1/SAMPLE2/fmt/AD>,
    <example-file1.vcf#sample/var1/SAMPLE2/fmt/DP>,
    <example-file1.vcf#sample/var1/SAMPLE2/fmt/GT> .

<example-file1.vcf#sample/var1/SAMPLE1/fmt/GT>
  a vcfc:FormatFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/8> ;
  vcfc:fieldValue "0/1" .

<example-file1.vcf#sample/var1/SAMPLE1/fmt/DP>
  a vcfc:FormatFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/9> ;
  vcfc:fieldValueInteger 42 .

<example-file1.vcf#sample/var1/SAMPLE1/fmt/AD>
  a vcfc:FormatFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/10> ;
  vcfc:fieldValue "30,12" .

<example-file1.vcf#sample/var1/SAMPLE2/fmt/GT>
  a vcfc:FormatFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/8> ;
  vcfc:fieldValue "0/1" .

<example-file1.vcf#sample/var1/SAMPLE2/fmt/DP>
  a vcfc:FormatFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/9> ;
  vcfc:fieldValueInteger 6 .

<example-file1.vcf#sample/var1/SAMPLE2/fmt/AD>
  a vcfc:FormatFieldValue ;
  vcfc:declaredBy <example-file1.vcf#header/line/10> ;
  vcfc:fieldValue "3,2" .
