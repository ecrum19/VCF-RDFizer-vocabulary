@base <file://> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .

# Version 1.1.0 condensed representation of three VCF sample columns.
<cohort.vcf>
  a vcfc:VCFFile ;
  vcfc:fileFormat "VCFv4.5" ;
  vcfc:representationProfile vcfc:CondensedRepresentation ;
  vcfc:hasSampleSet <cohort.vcf#samples> ;
  vcfc:hasRecord <cohort.vcf#record/1> .

<cohort.vcf#samples>
  a vcfc:SampleSet ;
  vcfc:hasSample
    <cohort.vcf#samples/SAMPLE1>,
    <cohort.vcf#samples/SAMPLE2>,
    <cohort.vcf#samples/SAMPLE3> .

<cohort.vcf#samples/SAMPLE1>
  a vcfc:VCFSample ;
  vcfc:sampleName "SAMPLE1" ;
  vcfc:sampleIndex 1 .

<cohort.vcf#samples/SAMPLE2>
  a vcfc:VCFSample ;
  vcfc:sampleName "SAMPLE2" ;
  vcfc:sampleIndex 2 .

<cohort.vcf#samples/SAMPLE3>
  a vcfc:VCFSample ;
  vcfc:sampleName "SAMPLE3" ;
  vcfc:sampleIndex 3 .

<cohort.vcf#record/1>
  a vcfc:VCFRecord ;
  vcfc:chrom "1" ;
  vcfc:pos 100 ;
  vcfc:ref "A" ;
  vcfc:alt "G" ;
  vcfc:hasCall <cohort.vcf#call/1> .

<cohort.vcf#call/1>
  a vcfc:VariantCall ;
  vcfc:formatRaw "GT:DP" ;
  vcfc:hasCallMatrix <cohort.vcf#call/1/matrix> .

<cohort.vcf#call/1/matrix>
  a vcfc:CohortCallMatrix ;
  vcfc:appliesToSampleSet <cohort.vcf#samples> ;
  vcfc:hasFormatValueVector
    <cohort.vcf#call/1/matrix/fmt/GT>,
    <cohort.vcf#call/1/matrix/fmt/DP> ;
  vcfc:sampleDataRaw "0/1:42\t0/0:18\t./.:." .

<cohort.vcf#call/1/matrix/fmt/GT>
  a vcfc:FormatValueVector ;
  vcfc:declaredBy <cohort.vcf#header/format/GT> ;
  vcfc:valueEncoding vcfc:VCFTextVector ;
  vcfc:encodedValues "0/1\t0/0\t./." .

<cohort.vcf#call/1/matrix/fmt/DP>
  a vcfc:FormatValueVector ;
  vcfc:declaredBy <cohort.vcf#header/format/DP> ;
  vcfc:valueEncoding vcfc:VCFTextVector ;
  vcfc:encodedValues "42\t18\t." .

<cohort.vcf#header/format/GT>
  a vcfc:FormatFieldDefinition ;
  vcfc:fieldId "GT" ;
  vcfc:fieldNumber "1" ;
  vcfc:fieldDescription "Genotype" .

<cohort.vcf#header/format/DP>
  a vcfc:FormatFieldDefinition ;
  vcfc:fieldId "DP" ;
  vcfc:fieldNumber "1" ;
  vcfc:fieldDescription "Read depth" .
