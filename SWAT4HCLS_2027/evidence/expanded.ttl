@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/vcf/synthetic.vcf#> .

# Synthetic vocabulary v1.1.0 example. The expanded profile is named
# ExpandedRepresentation in the vocabulary. Types needed for standalone
# validation are explicit; no vocabulary import or entailment is required.
vcfc:ExpandedRepresentation a vcfc:RepresentationProfile .

<https://example.org/vcf/synthetic.vcf>
  a vcfc:VCFFile ;
  vcfc:fileFormat "VCFv4.5" ;
  vcfc:representationProfile vcfc:ExpandedRepresentation ;
  vcfc:hasHeader ex:header ;
  vcfc:hasSampleSet ex:samples ;
  vcfc:hasRecord ex:record1 .

ex:header a vcfc:VCFHeader ;
  vcfc:hasHeaderLine ex:fileformat, ex:GT, ex:DP .
ex:fileformat a vcfc:FileFormatHeaderLine, vcfc:HeaderLine ;
  vcfc:headerKey "fileformat" ; vcfc:headerValue "VCFv4.5" .
ex:GT a vcfc:FormatFieldDefinition, vcfc:HeaderLine ;
  vcfc:headerKey "FORMAT" ;
  vcfc:headerValue "<ID=GT,Number=1,Type=String,Description=\"Genotype\">" ;
  vcfc:fieldId "GT" ; vcfc:fieldNumber "1" ;
  vcfc:fieldType vcfc:StringType ; vcfc:fieldDescription "Genotype" .
ex:DP a vcfc:FormatFieldDefinition, vcfc:HeaderLine ;
  vcfc:headerKey "FORMAT" ;
  vcfc:headerValue "<ID=DP,Number=1,Type=Integer,Description=\"Read depth\">" ;
  vcfc:fieldId "DP" ; vcfc:fieldNumber "1" ;
  vcfc:fieldType vcfc:IntegerType ; vcfc:fieldDescription "Read depth" .

ex:samples a vcfc:SampleSet ;
  vcfc:hasSample ex:SAMPLE1, ex:SAMPLE2, ex:SAMPLE3 .
ex:SAMPLE1 a vcfc:VCFSample ; vcfc:sampleName "SAMPLE1" ;
  vcfc:sampleIndex "1"^^xsd:positiveInteger .
ex:SAMPLE2 a vcfc:VCFSample ; vcfc:sampleName "SAMPLE2" ;
  vcfc:sampleIndex "2"^^xsd:positiveInteger .
ex:SAMPLE3 a vcfc:VCFSample ; vcfc:sampleName "SAMPLE3" ;
  vcfc:sampleIndex "3"^^xsd:positiveInteger .

ex:record1 a vcfc:VCFRecord ;
  vcfc:chrom "1" ; vcfc:pos 100 ; vcfc:recordId "."^^vcfc:Null ;
  vcfc:ref "A" ; vcfc:alt "G" ; vcfc:hasCall ex:call1 .
ex:call1 a vcfc:VariantCall ;
  vcfc:qual "60"^^xsd:decimal ; vcfc:filter "PASS" ;
  vcfc:infoRaw "." ; vcfc:formatRaw "GT:DP" ;
  vcfc:hasSampleCall ex:call1_SAMPLE1, ex:call1_SAMPLE2, ex:call1_SAMPLE3 .

ex:call1_SAMPLE1 a vcfc:SampleCall ;
  vcfc:sampleId "SAMPLE1" ; vcfc:forSample ex:SAMPLE1 ;
  vcfc:hasFormatValue ex:call1_SAMPLE1_GT, ex:call1_SAMPLE1_DP .
ex:call1_SAMPLE2 a vcfc:SampleCall ;
  vcfc:sampleId "SAMPLE2" ; vcfc:forSample ex:SAMPLE2 ;
  vcfc:hasFormatValue ex:call1_SAMPLE2_GT, ex:call1_SAMPLE2_DP .
ex:call1_SAMPLE3 a vcfc:SampleCall ;
  vcfc:sampleId "SAMPLE3" ; vcfc:forSample ex:SAMPLE3 ;
  vcfc:hasFormatValue ex:call1_SAMPLE3_GT, ex:call1_SAMPLE3_DP .

ex:call1_SAMPLE1_GT a vcfc:FormatFieldValue ;
  vcfc:declaredBy ex:GT ; vcfc:fieldValue "0/1" .
ex:call1_SAMPLE1_DP a vcfc:FormatFieldValue ;
  vcfc:declaredBy ex:DP ; vcfc:fieldValue "42" ; vcfc:fieldValueInteger 42 .
ex:call1_SAMPLE2_GT a vcfc:FormatFieldValue ;
  vcfc:declaredBy ex:GT ; vcfc:fieldValue "0/0" .
ex:call1_SAMPLE2_DP a vcfc:FormatFieldValue ;
  vcfc:declaredBy ex:DP ; vcfc:fieldValue "18" ; vcfc:fieldValueInteger 18 .
ex:call1_SAMPLE3_GT a vcfc:FormatFieldValue ;
  vcfc:declaredBy ex:GT ; vcfc:fieldValue "./." .
ex:call1_SAMPLE3_DP a vcfc:FormatFieldValue ;
  vcfc:declaredBy ex:DP ; vcfc:fieldValue "."^^vcfc:Null .
