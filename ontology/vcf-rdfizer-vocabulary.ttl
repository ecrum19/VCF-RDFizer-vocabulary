@prefix vcfr:   <https://w3id.org/vcf-rdfizer/vocab#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

@prefix so:     <http://purl.obolibrary.org/obo/SO_> .
@prefix faldo:  <http://biohackathon.org/resource/faldo#> .
@prefix geno:   <http://purl.obolibrary.org/obo/GENO_> .
@prefix sio:    <http://semanticscience.org/resource/SIO_> .
@prefix hero:   <https://w3id.org/hereditary/ontology/genomics/schema/> .
@prefix vrs:    <https://w3id.org/ga4gh/schema/vrs/2.0/json/> .

# SB/gvar uses https://ican.fr/ as its schema URI; keep prefix for convenience.
@prefix ican:   <https://ican.fr/> .

#################################################################
# Ontology header
#################################################################

vcfr: a owl:Ontology ;
  rdfs:label "VCF-RDFizer Vocabulary"@en ;
  dct:description "Vocabulary for representing VCF files, headers, records, and per-sample calls in RDF. Its VCF-facing terms document the VCF 4.5 syntax and semantics, while its alignment hooks can link calls to SB/gvar and other genomics ontologies."@en ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dct:creator "Elias Crum" ;
  owl:versionIRI <https://w3id.org/vcf-rdfizer/vocab/1.1.0> ;
  dct:issued "2026-02-10"^^xsd:date ;
  dct:modified "2026-09-05"^^xsd:date ;
  rdfs:seeAlso <https://samtools.github.io/hts-specs/VCFv4.5.pdf> ;
  rdfs:seeAlso <https://swat4hcls-2025-genomic-variation.github.io/genomic-variant-schema/> ;
  rdfs:seeAlso <https://hereditary.dei.unipd.it/ontology/genomics/> .

#################################################################
# Core classes
#################################################################

vcfr:VCFFile a owl:Class ;
  rdfs:label "VCF file"@en ;
  rdfs:comment "A Variant Call Format (VCF) file artifact represented as a dataset distribution. In VCF 4.5, the artifact contains meta-information lines, one column-header line, and zero or more tab-delimited data records."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}" ;
  skos:exactMatch hero:VCFFile ;
  rdfs:seeAlso hero:VCFFile ;
  rdfs:subClassOf dcat:Distribution, prov:Entity .

vcfr:VCFHeader a owl:Class ;
  rdfs:label "VCF header"@en ;
  rdfs:comment "A resource that groups the VCF file's meta-information header lines. VCF 4.5 meta-information lines begin with '##' and occur before the mandatory '#CHROM' column-header line and all data records."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#header" .

vcfr:HeaderLine a owl:Class ;
  rdfs:label "VCF header line"@en ;
  rdfs:comment "A representation of one VCF meta-information line, such as '##fileformat=VCFv4.5' or '##INFO=<...>'. A line may have an unstructured value or a structured, angle-bracketed list of key-value pairs."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#header/line/{lineId}" .

vcfr:FileFormatHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "fileformat header line"@en ;
  rdfs:comment "The required, first VCF meta-information line. Its value declares the VCF version, for example 'VCFv4.5'."@en .

vcfr:FileDateHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "fileDate header line"@en ;
  rdfs:comment "An optional producer-supplied '##fileDate' meta-information line. It is a commonly used unstructured header convention, rather than a required VCF 4.5 line."@en .

vcfr:SourceHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "source header line"@en ;
  rdfs:comment "An optional producer-supplied '##source' meta-information line, typically identifying the program, pipeline, or source that generated the VCF."@en .

vcfr:ReferenceHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "reference header line"@en ;
  rdfs:comment "An optional '##reference' meta-information line that identifies the reference genome or sequence resource used to interpret the records. Including reference and contig metadata is recommended by VCF 4.5."@en .

vcfr:ContigHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "contig header line"@en ;
  rdfs:comment "A structured '##contig=<...>' declaration for a reference sequence used by records in the file. VCF 4.5 requires its ID and reserves optional attributes such as length, md5, and URL; contig declarations are recommended in VCF and required in BCF."@en ;
  skos:relatedMatch faldo:Reference .

vcfr:INFOHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "INFO header line"@en ;
  rdfs:comment "A structured '##INFO=<...>' declaration that defines the identifier, cardinality, type, and meaning of an annotation that may occur in the INFO column. ID, Number, Type, and Description are required by VCF 4.5."@en .

vcfr:FORMATHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "FORMAT header line"@en ;
  rdfs:comment "A structured '##FORMAT=<...>' declaration that defines the identifier, cardinality, type, and meaning of a field in a per-sample column. ID, Number, Type, and Description are required by VCF 4.5."@en .

vcfr:FILTERHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "FILTER header line"@en ;
  rdfs:comment "A structured '##FILTER=<...>' declaration that defines a code which may appear in the FILTER column when a record does not pass that filter. ID and Description are required by VCF 4.5."@en .

vcfr:ALTHeaderLine a owl:Class ; rdfs:subClassOf vcfr:HeaderLine ;
  rdfs:label "ALT header line"@en ;
  rdfs:comment "A structured '##ALT=<...>' declaration that defines the meaning of a symbolic alternate-allele identifier. The identifier is used in the ALT column inside angle brackets, for example '<DEL>'."@en .

vcfr:VCFRecord a owl:Class ;
  rdfs:label "VCF record"@en ;
  rdfs:comment "One tab-delimited VCF data line. It contains the eight mandatory fixed fields CHROM, POS, ID, REF, ALT, QUAL, FILTER, and INFO; it may additionally contain a FORMAT field and one value block per sample. This is a VCF-centric representation that can link to a sequence-alteration model via vcfr:asSequenceAlteration."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#record/{recordId}" ;
  skos:exactMatch hero:VCFRecord ;
  skos:relatedMatch faldo:Region, vrs:SequenceLocation, vrs:Allele ;
  rdfs:seeAlso hero:VCFRecord, faldo:Region, vrs:SequenceLocation, vrs:Allele ;
  rdfs:subClassOf prov:Entity .

vcfr:VariantCall a owl:Class ;
  rdfs:label "variant call"@en ;
  rdfs:comment "A vocabulary-level resource that groups the call assessment carried by a VCF record: QUAL, FILTER, INFO, the FORMAT declaration, and any per-sample values. It is an RDF convenience for the contents of a record, not a separate line type in VCF syntax."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#call/{recordId}" ;
  skos:closeMatch hero:GenomicVariation, so:0001060, vrs:Allele ;
  rdfs:seeAlso hero:GenomicVariation, so:0001060, vrs:Allele ;
  rdfs:subClassOf prov:Entity .

vcfr:SampleCall a owl:Class ;
  rdfs:label "sample call"@en ;
  rdfs:comment "The colon-delimited value block for one sample in a genotype-bearing VCF record, represented as structured FORMAT field values. Its field order and meanings are supplied by that record's FORMAT column and corresponding FORMAT declarations."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#sample/{recordId}/{sampleId}" ;
  skos:closeMatch hero:Genotype ;
  skos:relatedMatch hero:Zygosity ;
  rdfs:seeAlso hero:Genotype, hero:Zygosity ;
  rdfs:subClassOf prov:Entity .

vcfr:FieldDefinition a owl:Class ;
  rdfs:label "field definition"@en ;
  rdfs:comment "A common RDF superclass for header declarations that define reusable INFO, FORMAT, FILTER, or symbolic ALT identifiers. It is a vocabulary abstraction over the respective VCF structured meta-information lines."@en ;
  rdfs:subClassOf vcfr:HeaderLine .

vcfr:InfoFieldDefinition a owl:Class ; rdfs:subClassOf vcfr:FieldDefinition, vcfr:INFOHeaderLine ;
  rdfs:label "INFO field definition"@en ;
  rdfs:comment "The definition of one INFO key, including its ID, Number, Type, and human-readable Description. It specifies how that key's site-level annotation values must be interpreted."@en .

vcfr:FormatFieldDefinition a owl:Class ; rdfs:subClassOf vcfr:FieldDefinition, vcfr:FORMATHeaderLine ;
  rdfs:label "FORMAT field definition"@en ;
  rdfs:comment "The definition of one FORMAT key, including its ID, Number, Type, and human-readable Description. It specifies how the corresponding per-sample values must be interpreted."@en .

vcfr:FilterDefinition a owl:Class ; rdfs:subClassOf vcfr:FieldDefinition, vcfr:FILTERHeaderLine ;
  rdfs:label "FILTER definition"@en ;
  rdfs:comment "The definition of one FILTER failure code. A VCF record that fails this criterion cites the code in its semicolon-separated FILTER value."@en .

vcfr:AltDefinition a owl:Class ; rdfs:subClassOf vcfr:FieldDefinition, vcfr:ALTHeaderLine ;
  rdfs:label "ALT definition"@en ;
  rdfs:comment "The definition of one symbolic ALT identifier. It provides the meaning of an angle-bracketed alternate allele such as '<DEL>' without asserting a particular variation model."@en .

vcfr:InfoFieldValue a owl:Class ;
  rdfs:label "INFO field value"@en ;
  rdfs:comment "A structured representation of one key and its optional value(s) from the INFO column of a VCF record. INFO entries are separated by semicolons, and an entry without an equals sign represents a Flag-style presence assertion."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#call/{recordId}/info/{fieldKey}" ;
  skos:relatedMatch hero:VariantLevelData ;
  rdfs:seeAlso hero:VariantLevelData .

vcfr:FormatFieldValue a owl:Class ;
  rdfs:label "FORMAT field value"@en ;
  rdfs:comment "A structured representation of one value from a sample's colon-delimited data block, interpreted at the corresponding position in the record's FORMAT key list."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#sample/{recordId}/{sampleId}/fmt/{fieldKey}" ;
  skos:relatedMatch hero:Genotype ;
  rdfs:seeAlso hero:Genotype .

#################################################################
# Condensed cohort representation
#################################################################

# The classes below describe the condensed serialization profile, in which a
# record's per-sample FORMAT values are kept as one vector per FORMAT key
# instead of one resource per sample and key. Both profiles describe the same
# VCF; they differ only in how many RDF resources the genotype block costs.
# A graph declares which profile it follows with vcfr:representationProfile.

vcfr:SampleSet a owl:Class ;
  rdfs:label "sample set"@en ;
  rdfs:comment "The ordered set of sample columns declared once for a VCF file by its '#CHROM' column-header line. Declaring the samples at file level, rather than repeating them per record, is what allows the condensed profile to address per-sample values positionally."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#samples" ;
  rdfs:subClassOf prov:Entity .

vcfr:VCFSample a owl:Class ;
  rdfs:label "VCF sample"@en ;
  rdfs:comment "One sample column of a VCF file, identified by its name in the column-header line and by its 1-based position among the sample columns. It is a file-level participant resource; the values it was assigned in a given record are carried by that record's vectors, at the position given by vcfr:sampleIndex."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#samples/{sampleId}" ;
  rdfs:seeAlso vcfr:SampleCall ;
  rdfs:subClassOf prov:Entity .

vcfr:CohortCallMatrix a owl:Class ;
  rdfs:label "cohort call matrix"@en ;
  rdfs:comment "The complete genotype block of one VCF record, held as a matrix over the file's sample set: one vector per FORMAT key, each vector carrying that key's value for every sample in sample-column order. It is the condensed counterpart of the set of vcfr:SampleCall resources a record would otherwise have."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#call/{recordId}/matrix" ;
  rdfs:seeAlso vcfr:SampleCall ;
  rdfs:subClassOf prov:Entity .

vcfr:FormatValueVector a owl:Class ;
  rdfs:label "FORMAT value vector"@en ;
  rdfs:comment "The values of one FORMAT key across every sample of a record, held as a single encoded literal rather than as one resource per sample. Its vcfr:declaredBy definition supplies the key's Type and Number, exactly as for a vcfr:FormatFieldValue; its vcfr:valueEncoding states how the literal is to be split back into per-sample values."@en ;
  vcfr:iriTemplate "file://{vcfFilePath}#call/{recordId}/matrix/fmt/{fieldKey}" ;
  rdfs:seeAlso vcfr:FormatFieldValue ;
  rdfs:subClassOf prov:Entity .

#################################################################
# Controlled vocab / enums (lightweight)
#################################################################

vcfr:VCFValueType a owl:Class ;
  rdfs:label "VCF value type"@en ;
  rdfs:comment "The declared VCF data type of an INFO or FORMAT field. INFO definitions may use Integer, Float, Flag, Character, or String; FORMAT definitions may use all of these except Flag."@en .

vcfr:IntegerType a owl:Class ; rdfs:subClassOf vcfr:VCFValueType ;
  rdfs:label "Integer"@en ;
  rdfs:comment "The VCF Integer type: a signed 32-bit integer value."@en .

vcfr:FloatType a owl:Class ; rdfs:subClassOf vcfr:VCFValueType ;
  rdfs:label "Float"@en ;
  rdfs:comment "The VCF Float type: a 32-bit IEEE-754 floating-point value, whose textual form may also express INF, INFINITY, or NAN."@en .

vcfr:FlagType a owl:Class ; rdfs:subClassOf vcfr:VCFValueType ;
  rdfs:label "Flag"@en ;
  rdfs:comment "The VCF presence-only type for an INFO key. A Flag has no value in the INFO column and its Number is 0; it is not permitted for FORMAT fields."@en .

vcfr:CharacterType a owl:Class ; rdfs:subClassOf vcfr:VCFValueType ;
  rdfs:label "Character"@en ;
  rdfs:comment "The VCF Character type, used when a field value is a single character."@en .

vcfr:StringType a owl:Class ; rdfs:subClassOf vcfr:VCFValueType ;
  rdfs:label "String"@en ;
  rdfs:comment "The VCF String type, used for a textual value whose permitted content is further constrained by the field in which it occurs."@en .

vcfr:VCFNumberArity a owl:Class ;
  rdfs:label "VCF Number arity"@en ;
  rdfs:comment "The cardinality declaration used in a structured INFO or FORMAT definition. Besides a non-negative integer, VCF 4.5 defines A (one value per ALT allele), R (one per allele including REF), G (one per genotype), and '.' (variable, unknown, or unbounded); FORMAT additionally defines LA, LR, LG, P, and M."@en .

vcfr:RepresentationProfile a owl:Class ;
  rdfs:label "representation profile"@en ;
  rdfs:comment "A declared serialization profile for the per-sample genotype block of a VCF graph. The profile does not change which VCF facts are represented; it determines which classes and properties carry them, and therefore which queries a consumer must write."@en .

vcfr:ExpandedRepresentation a owl:Class ; rdfs:subClassOf vcfr:RepresentationProfile ;
  rdfs:label "expanded representation"@en ;
  rdfs:comment "The profile in which every sample's value block is a vcfr:SampleCall carrying one vcfr:FormatFieldValue per FORMAT key. Every per-sample value is individually addressable as an RDF resource, at the cost of a number of resources proportional to records times samples times keys."@en .

vcfr:CondensedRepresentation a owl:Class ; rdfs:subClassOf vcfr:RepresentationProfile ;
  rdfs:label "condensed representation"@en ;
  rdfs:comment "The profile in which a record's genotype block is a vcfr:CohortCallMatrix of vcfr:FormatValueVector literals over a file-level vcfr:SampleSet. A per-sample value is reached by position rather than by IRI, which keeps the graph size proportional to records times keys and makes cohort-scale files tractable."@en .

vcfr:VectorEncoding a owl:Class ;
  rdfs:label "vector encoding"@en ;
  rdfs:comment "The scheme by which a vcfr:FormatValueVector literal is decoded into one value per sample. Stating it explicitly is what keeps a vector self-describing rather than dependent on out-of-band knowledge of the producer."@en .

vcfr:VCFTextVector a owl:Class ; rdfs:subClassOf vcfr:VectorEncoding ;
  rdfs:label "VCF text vector encoding"@en ;
  rdfs:comment "Values are encoded as one tab-separated field per sample, in ascending vcfr:sampleIndex order, with exactly as many fields as the sample set has members. A sample whose value is absent contributes the VCF missing token '.' at its position: within a vector the token is a character in the literal, not a '.'^^vcfr:Null literal of its own, because positional alignment must be preserved."@en .

vcfr:Null a rdfs:Datatype ;
  rdfs:label "null literal datatype"@en ;
  rdfs:comment "Datatype for the explicit VCF missing-value token '.'. VCF 4.5 uses this token whenever a field or allele value is missing; represent it as '.'^^vcfr:Null rather than as a plain string or a fabricated numeric value."@en .

#################################################################
# Object properties
#################################################################

vcfr:hasHeader a owl:ObjectProperty ;
  rdfs:label "has header"@en ;
  rdfs:comment "Associates a VCF file artifact with the resource that groups its meta-information header lines."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range vcfr:VCFHeader .

vcfr:hasHeaderLine a owl:ObjectProperty ;
  rdfs:label "has header line"@en ;
  rdfs:comment "Associates a VCF header with one of its meta-information lines. This preserves the individual declaration even when its structured attributes are also represented separately."@en ;
  rdfs:domain vcfr:VCFHeader ;
  rdfs:range vcfr:HeaderLine .

vcfr:hasRecord a owl:ObjectProperty ;
  rdfs:label "has record"@en ;
  rdfs:comment "Associates a VCF file with one of its tab-delimited data records."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range vcfr:VCFRecord .

vcfr:hasCall a owl:ObjectProperty ;
  rdfs:label "has call"@en ;
  rdfs:comment "Associates a VCF record with its vocabulary-level call resource, which groups QUAL, FILTER, INFO, FORMAT, and per-sample call data."@en ;
  rdfs:domain vcfr:VCFRecord ;
  rdfs:range vcfr:VariantCall .

vcfr:hasSampleCall a owl:ObjectProperty ;
  rdfs:label "has sample call"@en ;
  rdfs:comment "Associates a record-level call with the values for one sample. It is used only when the VCF record includes genotype columns."@en ;
  rdfs:domain vcfr:VariantCall ;
  rdfs:range vcfr:SampleCall .

vcfr:hasInfoValue a owl:ObjectProperty ;
  rdfs:label "has INFO value"@en ;
  rdfs:comment "Associates a record-level call with one structured annotation parsed from its INFO column."@en ;
  rdfs:domain vcfr:VariantCall ;
  rdfs:range vcfr:InfoFieldValue .

vcfr:hasFormatValue a owl:ObjectProperty ;
  rdfs:label "has FORMAT value"@en ;
  rdfs:comment "Associates a sample call with one structured value parsed from that sample's FORMAT-ordered data block."@en ;
  rdfs:domain vcfr:SampleCall ;
  rdfs:range vcfr:FormatFieldValue .

# Condensed cohort representation
vcfr:hasSampleSet a owl:ObjectProperty ;
  rdfs:label "has sample set"@en ;
  rdfs:comment "Associates a VCF file with the file-level set of sample columns its records are scored against. Asserted once per file; a file with no sample columns has none."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range vcfr:SampleSet .

vcfr:hasSample a owl:ObjectProperty ;
  rdfs:label "has sample"@en ;
  rdfs:comment "Associates a sample set with one of its member samples. The set is unordered as an RDF collection; the column order that vectors depend on is carried by vcfr:sampleIndex, not by this property."@en ;
  rdfs:domain vcfr:SampleSet ;
  rdfs:range vcfr:VCFSample .

vcfr:hasCallMatrix a owl:ObjectProperty ;
  rdfs:label "has call matrix"@en ;
  rdfs:comment "Associates a variant call with the condensed genotype block of its record. In the condensed profile this takes the place of the record's vcfr:hasSampleCall assertions."@en ;
  rdfs:domain vcfr:VariantCall ;
  rdfs:range vcfr:CohortCallMatrix .

vcfr:appliesToSampleSet a owl:ObjectProperty ;
  rdfs:label "applies to sample set"@en ;
  rdfs:comment "States which sample set a call matrix's vectors are aligned to. Without it a vector's positions cannot be resolved to samples, so it is required for the condensed profile to be interpretable."@en ;
  rdfs:domain vcfr:CohortCallMatrix ;
  rdfs:range vcfr:SampleSet .

vcfr:hasFormatValueVector a owl:ObjectProperty ;
  rdfs:label "has FORMAT value vector"@en ;
  rdfs:comment "Associates a call matrix with the vector holding one FORMAT key's values across all samples. A record contributes one vector per key in its FORMAT column."@en ;
  rdfs:domain vcfr:CohortCallMatrix ;
  rdfs:range vcfr:FormatValueVector .

vcfr:valueEncoding a owl:ObjectProperty ;
  rdfs:label "value encoding"@en ;
  rdfs:comment "States how a FORMAT value vector's literal is to be split into one value per sample. It makes the vector self-describing, so a consumer need not assume a particular producer's convention."@en ;
  rdfs:domain vcfr:FormatValueVector ;
  rdfs:range vcfr:VectorEncoding .

vcfr:representationProfile a owl:ObjectProperty ;
  rdfs:label "representation profile"@en ;
  rdfs:comment "Declares which genotype serialization profile a VCF graph follows. A consumer reads it first, because it determines whether per-sample values are addressed as vcfr:SampleCall resources or by position within a vcfr:FormatValueVector."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range vcfr:RepresentationProfile .

vcfr:declaredBy a owl:ObjectProperty ;
  rdfs:label "declared by"@en ;
  rdfs:comment "Links an INFO/FORMAT/FILTER/ALT value/usage to its header definition line."@en ;
  rdfs:range vcfr:FieldDefinition .

vcfr:chromosome a owl:ObjectProperty ;
  rdfs:label "chromosome / contig reference"@en ;
  rdfs:comment "Links a record to the declared contig corresponding to its CHROM value. The CHROM column identifies a reference sequence (or, for breakpoint assemblies, an angle-bracketed assembly contig ID); a resolvable external reference may also be aligned to FALDO."@en ;
  rdfs:seeAlso vrs:SequenceLocation ;
  rdfs:range vcfr:ContigHeaderLine .

vcfr:asSequenceAlteration a owl:ObjectProperty ;
  rdfs:label "as sequence alteration"@en ;
  rdfs:comment "Links the VCF-centric record or call to an independently modelled sequence alteration, such as an SB/gvar SequenceAlteration. This relation supports semantic alignment without changing the source VCF representation."@en ;
  rdfs:seeAlso vrs:Allele ;
  rdfs:range so:0001059 .

vcfr:missingValuePolicy a owl:AnnotationProperty ;
  rdfs:label "missing value policy"@en ;
  rdfs:comment "Documents how the VCF missing-value token '.' is represented when source values are transformed to RDF. It may be attached to the ontology to state the general rule, or to an individual term whose field departs from it."@en .

vcfr:iriTemplate a owl:AnnotationProperty ;
  rdfs:label "IRI template"@en ;
  rdfs:comment "Provides a recommended IRI-minting pattern, using RFC 6570-style placeholders, for instances of a vocabulary class."@en .

# The policy applies where VCF itself permits the missing token, which is not
# everywhere. Stating that boundary is what keeps the policy and the SHACL
# shapes consistent: a shape may require xsd:string for a field precisely
# because VCF gives that field no missing form, so a '.' there is malformed
# input rather than an absent value.
vcfr: vcfr:missingValuePolicy "In a field where VCF 4.5 permits the missing token '.' - ID, ALT, QUAL, FILTER, INFO, and any INFO or FORMAT value - it SHOULD be serialized as the literal '.'^^vcfr:Null, and MUST NOT be serialized as plain '.'^^xsd:string. CHROM, POS, and REF are required and have no missing form, so a '.' in one of them is malformed input and is not to be given a vcfr:Null literal. Within a vcfr:FormatValueVector the token stays a character at its sample's position in the encoded literal, because splitting it out would break positional alignment."@en .
vcfr: vcfr:iriTemplate "file://{vcfFilePath}" .

#################################################################
# Datatype properties (VCF metadata + record fields)
#################################################################

# Header common
vcfr:headerKey a owl:DatatypeProperty ;
  rdfs:label "header key"@en ;
  rdfs:comment "The meta-information key to the left of '=' in a header line, without the leading '##'; for example, 'fileformat', 'INFO', or 'contig'."@en ;
  rdfs:domain vcfr:HeaderLine ;
  rdfs:range xsd:string .

vcfr:headerValue a owl:DatatypeProperty ;
  rdfs:label "header value"@en ;
  rdfs:comment "The source value to the right of '=' in a VCF meta-information line. For a structured line, this may preserve the angle-bracketed key-value list in addition to its separately represented attributes."@en ;
  rdfs:domain vcfr:HeaderLine ;
  rdfs:range xsd:string .

# File-level metadata (common headers)
vcfr:fileFormat a owl:DatatypeProperty ;
  rdfs:label "file format"@en ;
  rdfs:comment "The VCF version string declared by the required '##fileformat' line, for example 'VCFv4.5'. That line must be the first line of a conforming VCF file."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range xsd:string .

vcfr:fileDate a owl:DatatypeProperty ;
  rdfs:label "file date"@en ;
  rdfs:comment "A producer-supplied file date, typically derived from an optional '##fileDate' header line. It records file metadata and is not one of VCF 4.5's required fixed fields."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range xsd:date .

vcfr:sourceSoftware a owl:DatatypeProperty ;
  rdfs:label "source software"@en ;
  rdfs:comment "The program, pipeline, or other source named by an optional '##source' header line."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range xsd:string .

vcfr:referenceGenome a owl:DatatypeProperty ;
  rdfs:label "reference genome"@en ;
  rdfs:comment "The reference genome or sequence resource identified by optional reference metadata, commonly a '##reference' header value. VCF 4.5 recommends recording reference and contig metadata to make the records interpretable."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range xsd:string .

vcfr:contigCount a owl:DatatypeProperty ;
  rdfs:label "contig count"@en ;
  rdfs:comment "The number of contig declarations associated with the file. This is a derived RDF convenience, not a separate VCF header field."@en ;
  rdfs:domain vcfr:VCFFile ;
  rdfs:range xsd:integer .

# Contig header details
vcfr:contigId a owl:DatatypeProperty ;
  rdfs:label "contig ID"@en ;
  rdfs:comment "The required ID attribute of a '##contig=<...>' declaration. It names the reference sequence that may be cited in CHROM and must not be a reserved symbolic-allele name."@en ;
  rdfs:domain vcfr:ContigHeaderLine ;
  rdfs:range xsd:string .

vcfr:contigLength a owl:DatatypeProperty ;
  rdfs:label "contig length"@en ;
  rdfs:comment "The optional 'length' attribute of a contig declaration: the length of the reference sequence in bases."@en ;
  rdfs:domain vcfr:ContigHeaderLine ;
  rdfs:range xsd:integer .

vcfr:contigAssembly a owl:DatatypeProperty ;
  rdfs:label "contig assembly"@en ;
  rdfs:comment "An optional assembly identifier supplied in a contig declaration. It identifies the reference assembly context for the named contig."@en ;
  rdfs:domain vcfr:ContigHeaderLine ;
  rdfs:range xsd:string .

vcfr:contigMd5 a owl:DatatypeProperty ;
  rdfs:label "contig MD5"@en ;
  rdfs:comment "The optional 'md5' attribute of a contig declaration: the lowercase hexadecimal MD5 checksum of the normalized reference sequence, as defined by the SAM specification and referenced by VCF 4.5."@en ;
  rdfs:domain vcfr:ContigHeaderLine ;
  rdfs:range xsd:string .

# INFO/FORMAT definition fields
vcfr:fieldId a owl:DatatypeProperty ;
  rdfs:label "field ID"@en ;
  rdfs:comment "The ID attribute of an INFO or FORMAT field declaration. It is the key used to identify a value in the INFO column or FORMAT-ordered sample data and is unique within its header-line type."@en ;
  rdfs:domain vcfr:FieldDefinition ;
  rdfs:range xsd:string .

vcfr:fieldNumber a owl:DatatypeProperty ;
  rdfs:label "field Number"@en ;
  rdfs:comment "The Number attribute from an INFO or FORMAT definition, retained as a string because VCF permits both integers and symbolic arities. A, R, and G follow REF/ALT or genotype order; '.' means variable, unknown, or unbounded; FORMAT also permits LA, LR, LG, P, and M."@en ;
  rdfs:domain vcfr:FieldDefinition ;
  rdfs:range xsd:string .

vcfr:fieldType a owl:ObjectProperty ;
  rdfs:label "field Type"@en ;
  rdfs:comment "Links an INFO or FORMAT field declaration to its VCF Type. INFO supports Integer, Float, Flag, Character, and String; FORMAT supports all of those except Flag."@en ;
  rdfs:domain vcfr:FieldDefinition ;
  rdfs:range vcfr:VCFValueType .

vcfr:fieldDescription a owl:DatatypeProperty ;
  rdfs:label "field Description"@en ;
  rdfs:comment "The human-readable Description attribute from a structured INFO, FORMAT, FILTER, or ALT header declaration. VCF requires this attribute to be quoted in the source header."@en ;
  rdfs:domain vcfr:FieldDefinition ;
  rdfs:range xsd:string .

# FILTER definition
vcfr:filterId a owl:DatatypeProperty ;
  rdfs:label "FILTER ID"@en ;
  rdfs:comment "The ID of a FILTER declaration: the failure code that can occur in the semicolon-separated FILTER column when the corresponding criterion is not passed."@en ;
  rdfs:domain vcfr:FilterDefinition ;
  rdfs:range xsd:string .

# ALT definition
vcfr:altId a owl:DatatypeProperty ;
  rdfs:label "ALT ID"@en ;
  rdfs:comment "The ID of a symbolic ALT declaration, stored without the angle brackets used when the identifier occurs in the ALT column."@en ;
  rdfs:domain vcfr:AltDefinition ;
  rdfs:range xsd:string .

# Record core columns
vcfr:chrom a owl:DatatypeProperty ;
  rdfs:label "CHROM"@en ;
  rdfs:comment "The required CHROM fixed-field value: an identifier for the reference sequence on which the record is located, or an angle-bracketed assembly-contig ID for a breakpoint assembly. Records for one CHROM occur in a contiguous block."@en ;
  rdfs:domain vcfr:VCFRecord ;
  rdfs:range xsd:string .

vcfr:pos a owl:DatatypeProperty ;
  rdfs:label "POS"@en ;
  rdfs:comment "The required 1-based reference position of the record. It denotes the first base of REF, is numerically ordered within CHROM, and may be 0 or N+1 to indicate a telomere for a contig of length N."@en ;
  rdfs:seeAlso vrs:SequenceLocation ;
  rdfs:domain vcfr:VCFRecord ;
  rdfs:range xsd:integer .

vcfr:recordId a owl:DatatypeProperty ;
  rdfs:label "ID"@en ;
  rdfs:comment "The ID fixed-field value: a semicolon-separated list of unique record identifiers, such as dbSNP rs identifiers. When no identifier is available, VCF uses '.', represented here as '.'^^vcfr:Null."@en ;
  vcfr:missingValuePolicy "VCF permits the missing token for ID; an absent identifier is '.'^^vcfr:Null."@en ;
  rdfs:domain vcfr:VCFRecord ;
  rdfs:range rdfs:Literal .

vcfr:ref a owl:DatatypeProperty ;
  rdfs:label "REF"@en ;
  rdfs:comment "The required reference allele string. It contains one or more A, C, G, T, or N bases and begins at POS. For simple insertions, deletions, and symbolic alleles, VCF uses an adjacent padding base to avoid an empty allele."@en ;
  rdfs:seeAlso vrs:LiteralSequenceExpression ;
  rdfs:domain vcfr:VCFRecord ;
  rdfs:range xsd:string .

vcfr:alt a owl:DatatypeProperty ;
  rdfs:label "ALT"@en ;
  rdfs:comment "An alternate, non-reference allele from the ALT fixed field. The VCF source serializes ALT as an ordered comma-separated list; each item may be a base string, '*', '.', a symbolic '<ID>', '<*>', or a breakend expression. Multiple values may be represented by repeated assertions or an external rdf:List, while retaining source order for Number=A, R, and G fields."@en ;
  vcfr:missingValuePolicy "VCF permits the missing token for ALT, meaning the record asserts no alternative allele; it is '.'^^vcfr:Null. The range below is the datatype of a present allele - see vcfr:VCFRecordShape, which admits both."@en ;
  rdfs:seeAlso vrs:LiteralSequenceExpression ;
  rdfs:domain vcfr:VCFRecord ;
  rdfs:range xsd:string .

# Call-level columns
vcfr:qual a owl:DatatypeProperty ;
  rdfs:label "QUAL"@en ;
  rdfs:comment "The QUAL fixed-field value: the Phred-scaled quality score for the assertion made in ALT. When ALT is '.', it is -10 log10 P(variant); otherwise it is -10 log10 P(no variant). An unknown score is represented by '.'^^vcfr:Null."@en ;
  rdfs:domain vcfr:VariantCall ;
  rdfs:range rdfs:Literal .

vcfr:filter a owl:DatatypeProperty ;
  rdfs:label "FILTER"@en ;
  rdfs:comment "The FILTER fixed-field value. 'PASS' means the position passed all filters; otherwise it is a semicolon-separated list of declared filter codes that failed. '.'^^vcfr:Null means filters have not been applied."@en ;
  rdfs:domain vcfr:VariantCall ;
  rdfs:range rdfs:Literal .

vcfr:infoRaw a owl:DatatypeProperty ;
  rdfs:label "INFO raw"@en ;
  rdfs:comment "An optional lossless copy of the INFO fixed-field string. In VCF it is '.' when no annotations are present, or a semicolon-separated series of key[=value[,value...]] entries. Use structured vcfr:InfoFieldValue resources for machine interpretation."@en ;
  rdfs:domain vcfr:VariantCall ;
  rdfs:range rdfs:Literal .

vcfr:formatRaw a owl:DatatypeProperty ;
  rdfs:label "FORMAT raw"@en ;
  rdfs:comment "An optional lossless copy of the FORMAT column: the colon-separated, ordered list of keys that determines the meaning of every sample data block in the record. If GT is included, it is the first key; the same field order applies to all samples in the record."@en ;
  rdfs:domain vcfr:VariantCall ;
  rdfs:range xsd:string .

# Structured INFO/FORMAT values
vcfr:fieldValue a owl:DatatypeProperty ;
  rdfs:label "field value"@en ;
  rdfs:comment "The literal value copied from a structured INFO or FORMAT entry. It may preserve a comma-separated VCF value list; when a source value is missing, use '.'^^vcfr:Null. The typed value properties may additionally be used where the source type and transformation support them."@en ;
  rdfs:domain rdf:Resource ;
  rdfs:range rdfs:Literal .

vcfr:fieldValueInteger a owl:DatatypeProperty ;
  rdfs:label "field value (integer)"@en ;
  rdfs:comment "An RDF integer representation of a parsed VCF Integer field value. Use vcfr:fieldValue for the original lexical form, lists, or missing values."@en ;
  rdfs:domain rdf:Resource ;
  rdfs:range xsd:integer .

vcfr:fieldValueDecimal a owl:DatatypeProperty ;
  rdfs:label "field value (decimal)"@en ;
  rdfs:comment "An RDF decimal representation of a parsed finite VCF Float field value. VCF Float may also use INF, INFINITY, or NAN; preserve such lexical values with vcfr:fieldValue rather than coercing them to xsd:decimal."@en ;
  rdfs:domain rdf:Resource ;
  rdfs:range xsd:decimal .

vcfr:fieldValueBoolean a owl:DatatypeProperty ;
  rdfs:label "field value (boolean)"@en ;
  rdfs:comment "An RDF boolean representation that may be used for the presence semantics of a VCF INFO Flag. In VCF source syntax, a Flag is indicated by a key without an explicit value and has Number=0."@en ;
  rdfs:domain rdf:Resource ;
  rdfs:range xsd:boolean .

# SampleCall identity
vcfr:sampleId a owl:DatatypeProperty ;
  rdfs:label "sample ID"@en ;
  rdfs:comment "The sample identifier from the column-header line. When genotype data is present, VCF places FORMAT after the eight fixed columns and then one uniquely named column per sample."@en ;
  rdfs:domain vcfr:SampleCall ;
  rdfs:range xsd:string .

# Condensed cohort representation
vcfr:sampleName a owl:DatatypeProperty ;
  rdfs:label "sample name"@en ;
  rdfs:comment "The name of a sample column as written in the '#CHROM' column-header line. It is the file-level counterpart of vcfr:sampleId, which names the sample of an individual expanded-profile call."@en ;
  rdfs:seeAlso vcfr:sampleId ;
  rdfs:domain vcfr:VCFSample ;
  rdfs:range xsd:string .

vcfr:sampleIndex a owl:DatatypeProperty ;
  rdfs:label "sample index"@en ;
  rdfs:comment "The 1-based position of a sample among the file's sample columns, counted in column-header order. It is the key that resolves a position within a vcfr:FormatValueVector to a sample, and so must be stable for the whole file."@en ;
  rdfs:domain vcfr:VCFSample ;
  rdfs:range xsd:positiveInteger .

vcfr:encodedValues a owl:DatatypeProperty ;
  rdfs:label "encoded values"@en ;
  rdfs:comment "The encoded per-sample values of one FORMAT key for one record, read according to the vector's vcfr:valueEncoding. Under vcfr:VCFTextVector the literal holds one tab-separated field per sample in ascending vcfr:sampleIndex order, with '.' at the position of an absent value."@en ;
  rdfs:domain vcfr:FormatValueVector ;
  rdfs:range xsd:string .

#################################################################
# Recommended alignments to SB/gvar (non-assertive hints)
#################################################################

# SB/gvar models sequence alteration as so:0001059 and uses FALDO/GENO/SIO slots. :contentReference[oaicite:2]{index=2}
vcfr:recommendedSequenceAlterationClass a owl:AnnotationProperty ;
  rdfs:label "recommended sequence alteration class"@en ;
  rdfs:comment "Documents a sequence-alteration class recommended as a target when a VCF-centric record or call is linked to a variation model. It is guidance for alignment and does not reclassify the VCF resource."@en .

vcfr:recommendedSequenceAlterationClass vcfr:recommendedSequenceAlterationClass so:0001059 .
