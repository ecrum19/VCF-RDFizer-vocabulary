@prefix vcfr:  <https://w3id.org/vcf-rdfizer/vocab#> .
@prefix vcfc:  <https://w3id.org/vcf-core/vocab#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

#################################################################
# Legacy document for the retired VCF-RDFizer Vocabulary namespace
#
# Served AT https://w3id.org/vcf-rdfizer/vocab so that IRIs minted
# under version 1.1.0 keep dereferencing to a document in which
# they are defined. The old namespace is deliberately NOT
# redirected to the new vocabulary: a redirect would land every
# legacy IRI in a document that does not define it, which is
# worse than a 404.
#
# Generated by scripts/migrate-namespace.mjs, then hand-patched in
# 2.0.0 for the five VCFValueType terms (see the note below each).
# Do not extend it with new terms.
#################################################################

vcfr: a owl:Ontology ;
  rdfs:label "VCF-RDFizer Vocabulary (retired namespace)"@en ;
  dct:description "Deprecation record for the retired VCF-RDFizer Vocabulary namespace. Every term defined up to version 1.1.0 is retained here as a deprecated term linked to its successor in the VCF Core Vocabulary. No new terms are added to this document."@en ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dct:creator "Elias Crum" ;
  owl:versionInfo "1.1.0-retired" ;
  dct:modified "2026-09-06"^^xsd:date ;
  owl:deprecated true ;
  dct:isReplacedBy vcfc: ;
  rdfs:seeAlso <https://w3id.org/vcf-core/vocab> .

#################################################################
# Term-by-term successor links (95 terms)
#################################################################

