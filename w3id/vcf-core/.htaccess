# https://w3id.org/vcf-core/
#
# VCF Core Vocabulary - an RDF vocabulary and SHACL profile for VCF 4.5 files,
# headers, records, calls, and genotype data.
#
# Maintainer: Elias Crum <elias.crum@ugent.be>
#             IDLab, Ghent University - imec, Belgium
# Source:     https://github.com/ecrum19/vcf-core-vocabulary
#
# BEFORE OPENING THE PULL REQUEST: replace every REPLACE-ME below with the real
# publishing host, with no trailing slash. If the companion site is published to
# GitHub Pages from this repository, that is
#   https://ecrum19.github.io/vcf-core-vocabulary
# and the generated site must actually serve the Turtle assets referenced here.
# Test the rules against a local checkout before submitting.
#
# The predecessor namespace https://w3id.org/vcf-rdfizer/ is handled by a
# SEPARATE .htaccess in this pull request. It is deliberately not redirected
# here: legacy IRIs must resolve to a document in which they are defined.

Options +FollowSymLinks
RewriteEngine on

# ---------------------------------------------------------------------------
# Vocabulary. Fragment IRIs such as .../vocab#VCFFile dereference to /vocab.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/n3 [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples [OR]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
# Serve the generated aggregate here so every vcfc: fragment dereferences to a
# document that contains its definition; normative module files remain routed
# individually below.
RewriteRule ^vocab/?$ REPLACE-ME/assets/vcf-core-vocabulary.bundle.ttl [R=302,L]

RewriteRule ^vocab/?$ REPLACE-ME/ontology-reference.html [R=302,L]

# Explicit file extensions bypass negotiation.
RewriteRule ^vocab\.ttl$ REPLACE-ME/assets/vcf-core-vocabulary.bundle.ttl [R=302,L]
RewriteRule ^vocab\.html$ REPLACE-ME/ontology-reference.html [R=302,L]

# Additive VCF 4.5 modules. These IRIs have no fragment namespace of their
# own; all terms continue to use the vcfc: namespace served at /vocab.
RewriteRule ^alleles/?$ REPLACE-ME/assets/vcf-core-alleles.ttl [R=302,L]
RewriteRule ^alleles\.ttl$ REPLACE-ME/assets/vcf-core-alleles.ttl [R=302,L]
RewriteRule ^genotypes/?$ REPLACE-ME/assets/vcf-core-genotypes.ttl [R=302,L]
RewriteRule ^genotypes\.ttl$ REPLACE-ME/assets/vcf-core-genotypes.ttl [R=302,L]
RewriteRule ^sv/?$ REPLACE-ME/assets/vcf-core-sv.ttl [R=302,L]
RewriteRule ^sv\.ttl$ REPLACE-ME/assets/vcf-core-sv.ttl [R=302,L]
RewriteRule ^reserved-keys/?$ REPLACE-ME/assets/vcf-core-reserved-keys.ttl [R=302,L]
RewriteRule ^reserved-keys\.ttl$ REPLACE-ME/assets/vcf-core-reserved-keys.ttl [R=302,L]

# Versioned snapshots (owl:versionIRI).
RewriteRule ^vocab/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://github.com/ecrum19/vcf-core-vocabulary/releases/tag/v$1 [R=302,L]

# ---------------------------------------------------------------------------
# SHACL shapes
# ---------------------------------------------------------------------------
RewriteRule ^shapes/?$ REPLACE-ME/assets/vcf-core-vocabulary.shacl.ttl [R=302,L]
RewriteRule ^shapes\.ttl$ REPLACE-ME/assets/vcf-core-vocabulary.shacl.ttl [R=302,L]
RewriteRule ^shapes/sparql/?$ REPLACE-ME/assets/vcf-core-vocabulary-sparql.shacl.ttl [R=302,L]
RewriteRule ^shapes/sparql\.ttl$ REPLACE-ME/assets/vcf-core-vocabulary-sparql.shacl.ttl [R=302,L]

# Shared consistency rules and version overlays; load with the portable/core profiles.
RewriteRule ^shapes/consistency(?:\.ttl)?/?$ REPLACE-ME/assets/vcf-core-consistency.shacl.ttl [R=302,L]
RewriteRule ^shapes/4\.([1-5])(?:\.ttl)?/?$ REPLACE-ME/assets/vcf-4.$1.shacl.ttl [R=302,L]
RewriteRule ^reserved-keys/4\.([1-4])(?:\.ttl)?/?$ REPLACE-ME/assets/vcf-4.$1-reserved.ttl [R=302,L]

# ---------------------------------------------------------------------------
# Examples
# ---------------------------------------------------------------------------
RewriteRule ^examples/?$ REPLACE-ME/index.html#examples [R=302,L]
RewriteRule ^examples/(.+)$ REPLACE-ME/assets/$1 [R=302,L]

# ---------------------------------------------------------------------------
# Instance IRI space, reserved. Nothing is published under it yet.
# ---------------------------------------------------------------------------
RewriteRule ^vcf/ - [R=404,L]

# ---------------------------------------------------------------------------
# Everything else: the companion documentation site.
# ---------------------------------------------------------------------------
RewriteRule ^$ REPLACE-ME/ [R=302,L]
RewriteRule ^(.*)$ REPLACE-ME/$1 [R=302,L]
