@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix vcfr:  <https://w3id.org/vcf-rdfizer/vocab#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix so:    <http://purl.obolibrary.org/obo/SO_> .

#################################################################
# VCFFile shape
#################################################################

vcfr:VCFFileShape a sh:NodeShape ;
  sh:targetClass vcfr:VCFFile ;

  sh:property [
    sh:path vcfr:hasHeader ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vcfr:VCFHeader ;
  ] ;

  sh:property [
    sh:path vcfr:fileFormat ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path vcfr:referenceGenome ;
    sh:minCount 0 ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path vcfr:fileDate ;
    sh:minCount 0 ;
    sh:datatype xsd:date ;
  ] ;

  sh:property [
    sh:path vcfr:hasRecord ;
    sh:minCount 0 ;
    sh:class vcfr:VCFRecord ;
  ] ;

  # The profile terms are classes used as values, following the vocabulary's
  # existing vcfr:VCFValueType pattern, so they carry no rdf:type edge and
  # sh:class cannot see them. sh:in states the permitted set directly, which is
  # also the stronger check: it rejects an unknown profile, not just an untyped
  # one.
  sh:property [
    sh:path vcfr:representationProfile ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:in ( vcfr:ExpandedRepresentation vcfr:CondensedRepresentation ) ;
  ] ;

  sh:property [
    sh:path vcfr:hasSampleSet ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:class vcfr:SampleSet ;
  ] .

#################################################################
# Header shape
#################################################################

vcfr:VCFHeaderShape a sh:NodeShape ;
  sh:targetClass vcfr:VCFHeader ;

  sh:property [
    sh:path vcfr:hasHeaderLine ;
    sh:minCount 1 ;
    sh:class vcfr:HeaderLine ;
  ] .

#################################################################
# INFO/FORMAT definition shapes (coverage of key attributes)
#################################################################

vcfr:InfoFieldDefinitionShape a sh:NodeShape ;
  sh:targetClass vcfr:InfoFieldDefinition ;

  sh:property [ sh:path vcfr:fieldId ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vcfr:fieldNumber ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vcfr:fieldDescription ; sh:minCount 1 ; sh:datatype xsd:string ] .

vcfr:FormatFieldDefinitionShape a sh:NodeShape ;
  sh:targetClass vcfr:FormatFieldDefinition ;

  sh:property [ sh:path vcfr:fieldId ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vcfr:fieldNumber ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vcfr:fieldDescription ; sh:minCount 1 ; sh:datatype xsd:string ] .

#################################################################
# VCFRecord + VariantCall shapes
#################################################################

vcfr:VCFRecordShape a sh:NodeShape ;
  sh:targetClass vcfr:VCFRecord ;

  # CHROM, POS and REF are required by VCF 4.5 and have no missing form, so the
  # datatype is exact: a '.' in one of them is malformed input, and the shape
  # should say so.
  sh:property [ sh:path vcfr:chrom ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vcfr:pos ; sh:minCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path vcfr:ref ; sh:minCount 1 ; sh:datatype xsd:string ] ;

  # ID and ALT do admit the missing token, so requiring xsd:string here would
  # contradict vcfr:missingValuePolicy: a record with no alternative allele
  # could satisfy neither. Both alternatives are admitted, as for QUAL.
  sh:property [
    sh:path vcfr:recordId ;
    sh:minCount 0 ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype vcfr:Null ]
    ) ;
  ] ;

  sh:property [
    sh:path vcfr:alt ;
    sh:minCount 1 ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype vcfr:Null ]
    ) ;
  ] ;

  sh:property [
    sh:path vcfr:hasCall ;
    sh:minCount 0 ;
    sh:class vcfr:VariantCall ;
  ] ;

  sh:property [
    sh:path vcfr:asSequenceAlteration ;
    sh:minCount 0 ;
    sh:class so:0001059 ;
  ] .

vcfr:VariantCallShape a sh:NodeShape ;
  sh:targetClass vcfr:VariantCall ;

  sh:property [
    sh:path vcfr:qual ;
    sh:minCount 0 ;
    sh:or (
      [ sh:datatype xsd:decimal ]
      [ sh:datatype vcfr:Null ]
    ) ;
  ] ;

  sh:property [
    sh:path vcfr:filter ;
    sh:minCount 0 ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype vcfr:Null ]
    ) ;
  ] ;

  sh:property [
    sh:path vcfr:hasInfoValue ;
    sh:minCount 0 ;
    sh:class vcfr:InfoFieldValue ;
  ] ;

  sh:property [
    sh:path vcfr:hasSampleCall ;
    sh:minCount 0 ;
    sh:class vcfr:SampleCall ;
  ] ;

  # The condensed profile's alternative to hasSampleCall. Neither is required:
  # a call in one profile simply has none of the other's genotype block.
  sh:property [
    sh:path vcfr:hasCallMatrix ;
    sh:minCount 0 ;
    sh:class vcfr:CohortCallMatrix ;
  ] .

#################################################################
# SampleCall shape
#################################################################

vcfr:SampleCallShape a sh:NodeShape ;
  sh:targetClass vcfr:SampleCall ;

  sh:property [ sh:path vcfr:sampleId ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vcfr:hasFormatValue ; sh:minCount 0 ; sh:class vcfr:FormatFieldValue ] .

#################################################################
# INFO/FORMAT value shapes
#################################################################

vcfr:InfoFieldValueShape a sh:NodeShape ;
  sh:targetClass vcfr:InfoFieldValue ;

  sh:property [
    sh:path vcfr:fieldValue ;
    sh:minCount 0 ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype vcfr:Null ]
    ) ;
  ] ;
  sh:property [ sh:path vcfr:declaredBy ; sh:minCount 0 ; sh:class vcfr:InfoFieldDefinition ] .

vcfr:FormatFieldValueShape a sh:NodeShape ;
  sh:targetClass vcfr:FormatFieldValue ;

  sh:property [
    sh:path vcfr:fieldValue ;
    sh:minCount 0 ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype vcfr:Null ]
    ) ;
  ] ;
  sh:property [ sh:path vcfr:declaredBy ; sh:minCount 0 ; sh:class vcfr:FormatFieldDefinition ] .

#################################################################
# Condensed cohort representation shapes
#################################################################
#
# These make a condensed graph checkable on the same terms as an expanded one.
# The constraints that matter are the ones positional decoding depends on: a
# vector must say which sample set it belongs to and how it is encoded, and
# every sample must carry an index, or a consumer cannot resolve a position to
# a sample at all.

vcfr:SampleSetShape a sh:NodeShape ;
  sh:targetClass vcfr:SampleSet ;

  sh:property [
    sh:path vcfr:hasSample ;
    sh:minCount 1 ;
    sh:class vcfr:VCFSample ;
  ] .

vcfr:VCFSampleShape a sh:NodeShape ;
  sh:targetClass vcfr:VCFSample ;

  sh:property [
    sh:path vcfr:sampleName ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;

  # Exactly one, and 1-based: an absent or duplicated index makes every vector
  # in the file ambiguous, so this is the strictest constraint in the profile.
  sh:property [
    sh:path vcfr:sampleIndex ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:positiveInteger ;
  ] .

vcfr:CohortCallMatrixShape a sh:NodeShape ;
  sh:targetClass vcfr:CohortCallMatrix ;

  sh:property [
    sh:path vcfr:appliesToSampleSet ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vcfr:SampleSet ;
  ] ;

  sh:property [
    sh:path vcfr:hasFormatValueVector ;
    sh:minCount 0 ;
    sh:class vcfr:FormatValueVector ;
  ] .

vcfr:FormatValueVectorShape a sh:NodeShape ;
  sh:targetClass vcfr:FormatValueVector ;

  # Unlike a FormatFieldValue, a vector cannot be read without its definition:
  # the FORMAT key's Type and Number are what give the decoded fields meaning.
  sh:property [
    sh:path vcfr:declaredBy ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vcfr:FormatFieldDefinition ;
  ] ;

  # An encoding term, like a representation profile, is a class used as a
  # value; sh:in both works under that pattern and pins the permitted set.
  sh:property [
    sh:path vcfr:valueEncoding ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vcfr:VCFTextVector ) ;
  ] ;

  # xsd:string, not vcfr:Null: a missing per-sample value is the character '.'
  # at that sample's position inside this literal, never a typed null in place
  # of the whole vector.
  sh:property [
    sh:path vcfr:encodedValues ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] .
